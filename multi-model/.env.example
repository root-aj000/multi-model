# ============================================================
# Multi-Model Prediction API — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Authentication ──────────────────────────────────────────
# Set to "true" to require authentication on all endpoints.
# Set to "false" to run in open mode (backward compatible).
AUTH_ENABLED=false

# ── Supabase Configuration ──────────────────────────────────
# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase anon/public key (safe for frontend)
SUPABASE_KEY=

# Supabase service_role key (bypasses RLS — NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (found in Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=

# ── Frontend URL (for CORS) ────────────────────────────────
# The URL where your Next.js frontend is running.
FRONTEND_URL=http://localhost:3000

# ── SMTP Configuration (for invite emails) ────────────────
# When not configured, invite links are logged to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
# Custom display name shown in the "From" field of invite emails.
# Example: "Multi-Model" will show as "Multi-Model <your-email@gmail.com>"
SMTP_FROM_NAME=Multi-Model

# ── Application ─────────────────────────────────────────────
# Path to model configuration file
CONFIG_PATH=configs/model/model_config.json

# Environment: "dev" for development (enables hot reload)
ENV=dev
